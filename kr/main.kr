device UART0 at 0x10000000 {
    THR at 0x00 : u8
    LSR at 0x05 : u8
}

fn putc(u8 c) {
    while (UART0.LSR & 0x20) == 0 { }
    UART0.THR = c
}

fn puts(u32 s) {
    u32 i = 0
    u32 ch = load8(s + i)
    while ch != 0 {
        putc(ch)
        i = i + 1
        ch = load8(s + i)
    }
}

fn main() -> u32 {
    u32 msg = "Hello from RISC-V bare metal!\r\n"
    puts(msg)
    return 0
}
